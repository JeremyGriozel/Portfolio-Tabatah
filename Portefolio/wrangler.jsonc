{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "portfolio-tabatah",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-08-12",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	}
}
