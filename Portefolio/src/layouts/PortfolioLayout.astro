---
import type { CollectionEntry } from 'astro:content';
import ImageFrame from '../components/ui/ImageFrame.astro';
import Lightbox from '../components/ui/Lightbox.astro';
import Tag from '../components/ui/Tag.astro';
import ProjectGallery from '../components/portfolio/ProjectGallery.astro';
import ProjectHeader from '../components/portfolio/ProjectHeader.astro';
import ProjectNavigation from '../components/portfolio/ProjectNavigation.astro';
import { galleryTagOptions, portfolioCategories, portfolioContent } from '../data/portfolio';
import { normalizeGalleryImage } from '../lib/project-taxonomy';
import BaseLayout from './BaseLayout.astro';

interface Props {
	project: CollectionEntry<'projects'>;
	previousProject?: CollectionEntry<'projects'>;
	nextProject?: CollectionEntry<'projects'>;
}

const { project, previousProject, nextProject } = Astro.props;
const { title, shortDescription, detailedDescription, cover, gallery, tools } = project.data;
const initialTheme = project.data.defaultTheme;
const lightboxId = `project-${project.id}`;
const normalizedGallery = gallery.map((galleryImage, index) =>
	normalizeGalleryImage(galleryImage, title, index));
const hasTaggedImages = normalizedGallery.some((image) => image.tags.length > 0);
const taggedGroups = galleryTagOptions
	.map((tag) => ({
		...tag,
		images: normalizedGallery.filter((image) => image.primaryTag === tag.value),
	}))
	.filter((group) => group.images.length > 0);
const untaggedImages = normalizedGallery.filter((image) => image.tags.length === 0);
const galleryGroups = hasTaggedImages
	? [
		...taggedGroups,
		...(untaggedImages.length > 0
			? [{ value: 'untagged', label: 'Autres images', images: untaggedImages }]
			: []),
	]
	: [];
let nextGalleryIndex = 1;
const indexedGalleryGroups = galleryGroups.map((group) => {
	const startIndex = nextGalleryIndex;
	nextGalleryIndex += group.images.length;
	return { ...group, startIndex };
});
const orderedGallery = hasTaggedImages
	? indexedGalleryGroups.flatMap((group) => group.images)
	: normalizedGallery;
const lightboxImages = [{ src: cover.src, alt: cover.alt }, ...orderedGallery];
---

<BaseLayout
	title={title}
	description={shortDescription}
	image={cover.src}
	imageAlt={cover.alt}
	ogType="article"
	{initialTheme}
>
	<section class="project-hero-panel section-panel" data-section-panel>
		<ProjectHeader
			project={project}
			categories={portfolioCategories}
			backLabel={portfolioContent.project.backLabel}
		/>
		<div class="project-cover container" data-reveal="image">
			<a
				class="lightbox-trigger"
				href={cover.src}
				aria-label={`Agrandir l’image de couverture du projet ${title}`}
				data-lightbox-trigger={lightboxId}
				data-lightbox-index="0"
			>
				<ImageFrame src={cover.src} alt={cover.alt} aspect={cover.aspect ?? 'wide'} loading="eager" />
			</a>
		</div>
	</section>

	{(detailedDescription || tools.length > 0) && (
		<section class="container project-details section-panel" data-section-panel>
			{detailedDescription && (
				<div class="project-details__copy flow">
					<h2 data-reveal>{portfolioContent.project.detailsTitle}</h2>
					<p class="project-details__description" data-reveal style="--reveal-order: 1">{detailedDescription}</p>
				</div>
			)}
			{tools.length > 0 && (
				<aside class="project-details__aside flow" data-reveal style="--reveal-order: 2">
					<h3>{portfolioContent.project.toolsTitle}</h3>
					<ul class="tag-list">{tools.map((tool) => <li><Tag label={tool} /></li>)}</ul>
				</aside>
			)}
		</section>
	)}

	{normalizedGallery.length > 0 && (
		<section class="container project-gallery-section section-panel" data-section-panel>
			<h2 class="section-title" data-reveal>{portfolioContent.project.galleryTitle}</h2>
			{hasTaggedImages ? (
				<div class="project-gallery-groups">
					{indexedGalleryGroups.map((group) => (
						<section class="project-gallery-group" aria-labelledby={`${lightboxId}-${group.value}`}>
							<h3 id={`${lightboxId}-${group.value}`} class="project-gallery-group__title" data-reveal>
								{group.label}
							</h3>
							<ProjectGallery images={group.images} {lightboxId} startIndex={group.startIndex} />
						</section>
					))}
				</div>
			) : (
				<ProjectGallery images={normalizedGallery} {lightboxId} startIndex={1} />
			)}
		</section>
	)}

	<Lightbox id={lightboxId} images={lightboxImages} label={`Galerie du projet ${title}`} />

	<ProjectNavigation
		{previousProject}
		{nextProject}
		title={portfolioContent.project.navigationTitle}
		previousLabel={portfolioContent.project.previousLabel}
		nextLabel={portfolioContent.project.nextLabel}
	/>
</BaseLayout>
