---
import { getCollection } from 'astro:content';
import IllustrationGallery from '../../components/portfolio/IllustrationGallery.astro';
import ProjectArchive from '../../components/portfolio/ProjectArchive.astro';
import {
	illustrationGalleryContent,
	portfolioCategories,
	portfolioContent,
} from '../../data/portfolio';
import { getProjectCategorySlugs } from '../../lib/project-taxonomy';
import BaseLayout from '../../layouts/BaseLayout.astro';

const category = portfolioCategories.find((item) => item.slug === 'illustration')!;
const projects = await getCollection(
	'projects',
	({ data }) => data.published && getProjectCategorySlugs(data).includes(category.slug),
);
---

<BaseLayout title="Illustration" description={category.description}>
	<ProjectArchive
		projects={projects}
		categories={portfolioCategories}
		eyebrow={portfolioContent.index.eyebrow}
		title={category.label}
		description={category.description}
		currentCategory={category.slug}
		filtersLabel={portfolioContent.filtersLabel}
		allProjectsLabel={portfolioContent.allProjectsLabel}
		emptyMessage={portfolioContent.emptyMessage}
		sortMode="categoryOrder"
	/>
	<IllustrationGallery projects={projects} copy={illustrationGalleryContent} />
</BaseLayout>
