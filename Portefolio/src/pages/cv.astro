---
import Button from '../components/ui/Button.astro';
import SectionTitle from '../components/ui/SectionTitle.astro';
import cvConfig from '../data/cv.json';
import { siteConfig } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const { cv } = siteConfig.pages;
const cvSourcePath = cvConfig.cv;
const cvPath = `${cvSourcePath}?v=${__CV_REVISION__}`;
---

<BaseLayout title="CV" description={cv.intro}>
	<section class="archive-header container cv-page">
		<SectionTitle title={cv.title} description={cv.intro} headingLevel="h1" />
		<nav class="cv-actions" aria-label="Actions du CV" data-reveal style="--reveal-order: 1">
			<Button href={cvPath} target="_blank">{cv.openLabel}</Button>
			<Button href={cvPath} variant="secondary" download>{cv.downloadLabel}</Button>
			<Button href={cv.portfolioLink.href} variant="secondary">{cv.portfolioLink.label}</Button>
			<Button href={cv.contactLink.href} variant="secondary">{cv.contactLink.label}</Button>
		</nav>
		<object class="cv-frame" data={cvPath} type="application/pdf" data-reveal="image">
			<div class="cv-fallback flow">
				<p>{cv.fallbackText}</p>
				<p><a href={cvPath} target="_blank">{cv.openLabel}</a> · <a href={cvPath} download>{cv.downloadLabel}</a></p>
			</div>
		</object>
		<div class="cv-mobile-panel flow">
			<p>{cv.mobileText}</p>
		</div>
	</section>
</BaseLayout>
