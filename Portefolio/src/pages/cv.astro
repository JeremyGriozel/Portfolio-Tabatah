---
import Button from '../components/ui/Button.astro';
import SectionTitle from '../components/ui/SectionTitle.astro';
import cvConfig from '../data/cv.json';
import { siteConfig } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const { cv } = siteConfig.pages;
const cvPath = cvConfig.cv;
---

<BaseLayout title={cv.title} description={cv.intro}>
	<section class="archive-header container cv-page">
		<SectionTitle title={cv.title} description={cv.intro} headingLevel="h1" />
		<div class="cv-actions cluster" data-reveal style="--reveal-order: 1">
			<Button href={cvPath} target="_blank">{cv.openLabel}</Button>
			<Button href={cvPath} variant="secondary" download>{cv.downloadLabel}</Button>
		</div>
		<nav class="cv-related-links cluster" aria-label="Liens complémentaires">
			<a href={cv.portfolioLink.href}>{cv.portfolioLink.label}</a>
			<a href={cv.contactLink.href}>{cv.contactLink.label}</a>
		</nav>
		<object class="cv-frame" data={cvPath} type="application/pdf" data-reveal="image">
			<div class="cv-fallback flow">
				<p>{cv.fallbackText}</p>
				<p><a href={cvPath} target="_blank">{cv.openLabel}</a> · <a href={cvPath} download>{cv.downloadLabel}</a></p>
			</div>
		</object>
		<div class="cv-mobile-panel flow">
			<p>{cv.mobileText}</p>
			<div class="cluster">
				<Button href={cvPath} target="_blank">{cv.openLabel}</Button>
				<Button href={cvPath} variant="secondary" download>{cv.downloadLabel}</Button>
			</div>
		</div>
	</section>
</BaseLayout>
