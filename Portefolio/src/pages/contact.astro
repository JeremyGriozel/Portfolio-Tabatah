---
import ContactForm from '../components/contact/ContactForm.astro';
import ContactInfo from '../components/contact/ContactInfo.astro';
import SectionTitle from '../components/ui/SectionTitle.astro';
import { contactContent } from '../data/contact';
import { siteConfig } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title={contactContent.page.title} description={contactContent.page.intro}>
	<section class="archive-header container">
		<SectionTitle {...contactContent.page} headingLevel="h1" />
	</section>
	<section class="contact-section section">
		<div class="container contact-layout">
			<ContactInfo site={siteConfig} labels={contactContent.info} />
			<ContactForm copy={contactContent.form} />
		</div>
	</section>
</BaseLayout>
