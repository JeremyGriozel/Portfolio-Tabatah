---
import ContactForm from '../components/contact/ContactForm.astro';
import ContactInfo from '../components/contact/ContactInfo.astro';
import SectionTitle from '../components/ui/SectionTitle.astro';
import { contactConfig, contactContent } from '../data/contact';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description={contactContent.page.intro}>
	<section class="archive-header container section-panel" data-section-panel>
		<SectionTitle {...contactContent.page} headingLevel="h1" />
	</section>
	<section class="contact-section section section-panel" data-section-panel>
		<div class="container contact-layout">
			<ContactInfo contact={contactConfig} labels={contactContent.info} />
			<ContactForm copy={contactContent.form} />
		</div>
	</section>
</BaseLayout>
