---
interface Props {
	title: string;
	eyebrow?: string;
	description?: string;
	align?: 'left' | 'center';
	headingLevel?: 'h1' | 'h2';
}

const { title, eyebrow, description, align = 'left', headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
---

<header class:list={['section-title', align === 'center' && 'section-title--center']}>
	{eyebrow && <p class="section-title__eyebrow" data-reveal>{eyebrow}</p>}
	<Heading data-reveal style="--reveal-order: 1">{title}</Heading>
	{description && <p class="section-title__description" data-reveal style="--reveal-order: 2">{description}</p>}
</header>
