---
import Button from '../ui/Button.astro';
import { contactFormLimits } from '../../lib/contact-form';

interface Props {
	copy: {
		nameLabel: string;
		namePlaceholder: string;
		emailLabel: string;
		emailPlaceholder: string;
		subjectLabel: string;
		subjectPlaceholder: string;
		messageLabel: string;
		messagePlaceholder: string;
		submitLabel: string;
		helpText: string;
		sendingMessage: string;
		successMessage: string;
		errorMessage: string;
	};
}

const { copy } = Astro.props;
---

<form
	class="contact-form"
	action="/api/contact"
	method="post"
	data-contact-form
	data-reveal
	style="--reveal-order: 1"
	data-sending-message={copy.sendingMessage}
	data-success-message={copy.successMessage}
	data-error-message={copy.errorMessage}
>
	<div class="form-field">
		<label for="contact-name">{copy.nameLabel}</label>
		<input id="contact-name" name="name" type="text" autocomplete="name" placeholder={copy.namePlaceholder} maxlength={contactFormLimits.name} required />
	</div>
	<div class="form-field">
		<label for="contact-email">{copy.emailLabel}</label>
		<input id="contact-email" name="email" type="email" autocomplete="email" placeholder={copy.emailPlaceholder} maxlength={contactFormLimits.email} required />
	</div>
	<div class="form-field">
		<label for="contact-subject">{copy.subjectLabel}</label>
		<input id="contact-subject" name="subject" type="text" placeholder={copy.subjectPlaceholder} maxlength={contactFormLimits.subject} required />
	</div>
	<div class="form-field">
		<label for="contact-message">{copy.messageLabel}</label>
		<textarea id="contact-message" name="message" placeholder={copy.messagePlaceholder} maxlength={contactFormLimits.message} required></textarea>
	</div>
	<div class="form-field visually-hidden" aria-hidden="true">
		<label for="contact-website">Site internet</label>
		<input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
	</div>
	<p class="contact-form__help" id="contact-form-help">{copy.helpText}</p>
	<p class="contact-form__status" id="contact-form-status" role="status" aria-live="polite" tabindex="-1" hidden data-form-status></p>
	<div><Button type="submit">{copy.submitLabel}</Button></div>
</form>

<script>
	document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			const status = form.querySelector<HTMLElement>('[data-form-status]');
			const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
			if (!status || !submitButton || form.dataset.submitting === 'true') return;

			const defaultLabel = submitButton.textContent ?? '';
			const sendingMessage = form.dataset.sendingMessage ?? 'Envoi en cours...';
			const successMessage = form.dataset.successMessage ?? 'Votre message a bien été envoyé.';
			const errorMessage = form.dataset.errorMessage ?? 'Une erreur est survenue. Veuillez réessayer.';

			form.dataset.submitting = 'true';
			submitButton.disabled = true;
			submitButton.textContent = sendingMessage;
			status.hidden = false;
			status.textContent = sendingMessage;

			try {
				const formData = new FormData(form);
				const response = await fetch(form.action, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(Object.fromEntries(formData)),
				});
				const result = await response.json().catch(() => null);

				if (!response.ok || !result?.success) throw new Error('Contact request failed');

				status.textContent = successMessage;
				form.reset();
			} catch {
				status.textContent = errorMessage;
			} finally {
				delete form.dataset.submitting;
				submitButton.disabled = false;
				submitButton.textContent = defaultLabel;
				status.focus({ preventScroll: true });
			}
		});
	});
</script>
