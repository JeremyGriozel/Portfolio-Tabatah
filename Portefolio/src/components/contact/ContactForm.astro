---
import Button from '../ui/Button.astro';

interface Props {
	copy: {
		nameLabel: string;
		namePlaceholder: string;
		emailLabel: string;
		emailPlaceholder: string;
		subjectLabel: string;
		subjectPlaceholder: string;
		messageLabel: string;
		messagePlaceholder: string;
		submitLabel: string;
		helpText: string;
		successMessage: string;
	};
}

const { copy } = Astro.props;
---

<form class="contact-form" data-contact-form>
	<div class="form-field">
		<label for="contact-name">{copy.nameLabel}</label>
		<input id="contact-name" name="name" type="text" autocomplete="name" placeholder={copy.namePlaceholder} required />
	</div>
	<div class="form-field">
		<label for="contact-email">{copy.emailLabel}</label>
		<input id="contact-email" name="email" type="email" autocomplete="email" placeholder={copy.emailPlaceholder} required />
	</div>
	<div class="form-field">
		<label for="contact-subject">{copy.subjectLabel}</label>
		<input id="contact-subject" name="subject" type="text" placeholder={copy.subjectPlaceholder} required />
	</div>
	<div class="form-field">
		<label for="contact-message">{copy.messageLabel}</label>
		<textarea id="contact-message" name="message" placeholder={copy.messagePlaceholder} required></textarea>
	</div>
	<p class="contact-form__help" id="contact-form-help">{copy.helpText}</p>
	<p class="contact-form__status" id="contact-form-status" role="status" tabindex="-1" hidden data-form-status>
		{copy.successMessage}
	</p>
	<div><Button type="submit">{copy.submitLabel}</Button></div>
</form>

<script>
	document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
		form.addEventListener('submit', (event) => {
			event.preventDefault();
			const status = form.querySelector<HTMLElement>('[data-form-status]');
			if (!status) return;
			status.hidden = false;
			status.focus({ preventScroll: true });
			form.reset();
		});
	});
</script>
