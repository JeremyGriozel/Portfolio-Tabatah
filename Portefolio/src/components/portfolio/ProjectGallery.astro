---
import ImageFrame from '../ui/ImageFrame.astro';

interface GalleryImage {
	src: string;
	alt: string;
}

interface Props {
	images: GalleryImage[];
	lightboxId: string;
	startIndex?: number;
}

const { images, lightboxId, startIndex = 0 } = Astro.props;
const gallerySize = images.length === 1 ? 'single' : images.length === 2 ? 'double' : 'multiple';
---

<div class:list={['project-gallery', `project-gallery--${gallerySize}`]}>
	{images.map((image, index) => (
		<div class="project-gallery__item" data-reveal="image" style={`--reveal-order: ${index % 3}`}>
			<a
				class="lightbox-trigger"
				href={image.src}
				aria-label={`Agrandir l’image ${index + 1} sur ${images.length}`}
				data-lightbox-trigger={lightboxId}
				data-lightbox-index={startIndex + index}
			>
				<ImageFrame src={image.src} alt={image.alt} aspect="landscape" />
			</a>
		</div>
	))}
</div>
