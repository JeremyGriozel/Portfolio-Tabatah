---
import type { CollectionEntry } from 'astro:content';
import type { PortfolioCategory } from '../../data/portfolio';
import { getProjectCategorySlugs } from '../../lib/project-taxonomy';
import Tag from '../ui/Tag.astro';

interface Props {
	project: CollectionEntry<'projects'>;
	categories: PortfolioCategory[];
	backLabel: string;
}

const { project, categories, backLabel } = Astro.props;
const { title, shortDescription, date, tags } = project.data;
const categoryLabels = getProjectCategorySlugs(project.data).map((categorySlug) =>
	categories.find((item) => item.slug === categorySlug)?.label ?? categorySlug,
);
const categoryLabel = categoryLabels.join(' · ');
const formattedDate = new Intl.DateTimeFormat('fr-FR', { month: 'long', year: 'numeric' }).format(date);
---

<header class="project-header container">
	<a class="project-header__back" href="/portfolio/">← {backLabel}</a>
	<div class="project-header__grid">
		<div>
			{categoryLabel && <p class="eyebrow" data-reveal>{categoryLabel}</p>}
			<h1 class="project-header__title" data-reveal style="--reveal-order: 1">{title}</h1>
			<p class="project-header__description" data-reveal style="--reveal-order: 2">{shortDescription}</p>
		</div>
		<div data-reveal style="--reveal-order: 2">
			<dl class="project-header__meta">
				<div><dt>Date</dt><dd><time datetime={date.toISOString()}>{formattedDate}</time></dd></div>
				<div><dt>Catégories</dt><dd>{categoryLabel || 'Non classé'}</dd></div>
			</dl>
			{tags.length > 0 && <ul class="tag-list" aria-label="Mots-clés">{tags.map((tag) => <li><Tag label={tag} /></li>)}</ul>}
		</div>
	</div>
</header>
