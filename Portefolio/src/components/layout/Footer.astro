---
import { navigationItems } from '../../data/navigation';
import { contactConfig } from '../../data/contact';
import { siteConfig } from '../../data/site';

const currentYear = new Date().getFullYear();
const footerLinks = navigationItems.flatMap((item) => [item, ...(item.children ?? [])]);
---

<footer class="site-footer">
	<div class="container">
		<div class="site-footer__grid">
			<div class="site-footer__identity">
				<p class="site-footer__name">{siteConfig.name}</p>
				<p class="site-footer__message">{siteConfig.footer.message}</p>
				<p class="site-footer__heading">{siteConfig.footer.contactLabel}</p>
				<a href={`mailto:${contactConfig.publicEmail}`}>{contactConfig.publicEmail}</a>
				{contactConfig.showPhone && contactConfig.phone && (
					<a href={`tel:${contactConfig.phone.replace(/\s/g, '')}`}>{contactConfig.phone}</a>
				)}
			</div>
			<nav aria-label={siteConfig.footer.navigationLabel}>
				<p class="site-footer__heading">{siteConfig.footer.navigationLabel}</p>
				<ul class="site-footer__links">
					{footerLinks.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
				</ul>
			</nav>
			<div>
				<p class="site-footer__heading">{siteConfig.footer.socialsLabel}</p>
				<ul class="site-footer__links">
					{contactConfig.socials.map((social) => (
						<li><a href={social.href} target="_blank" rel="noreferrer">{social.label}</a></li>
					))}
				</ul>
			</div>
		</div>
		<div class="site-footer__bottom">
			<p>© {currentYear} {siteConfig.name}</p>
			<p>{siteConfig.footer.legal}</p>
		</div>
	</div>
</footer>
