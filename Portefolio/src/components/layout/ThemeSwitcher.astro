---
import { siteConfig, themeOptions } from '../../data/site';

const configuredTheme = themeOptions.find(({ value }) => value === siteConfig.theme) ?? themeOptions[0];
---

<div class="theme-switcher" data-theme-switcher>
	<button
		class="theme-switcher__toggle"
		type="button"
		aria-expanded="false"
		aria-controls="theme-switcher-list"
		data-theme-toggle
	>
		<span>Thème</span>
		<span class="theme-switcher__current" data-theme-current>{configuredTheme.label}</span>
		<span class="theme-switcher__chevron" aria-hidden="true">⌄</span>
	</button>

	<ul class="theme-switcher__menu" id="theme-switcher-list" aria-label="Choisir un thème" hidden data-theme-menu>
		{themeOptions.map(({ value, label }) => (
			<li>
				<button
					class="theme-switcher__option"
					type="button"
					data-theme-value={value}
					data-theme-label={label}
					aria-pressed={value === siteConfig.theme ? 'true' : 'false'}
				>
					{label}
				</button>
			</li>
		))}
	</ul>
</div>

<script>
	const themeStorageKey = 'portfolio-theme';

	document.querySelectorAll<HTMLElement>('[data-theme-switcher]').forEach((switcher) => {
		const toggle = switcher.querySelector<HTMLButtonElement>('[data-theme-toggle]');
		const menu = switcher.querySelector<HTMLElement>('[data-theme-menu]');
		const currentLabel = switcher.querySelector<HTMLElement>('[data-theme-current]');
		const options = Array.from(switcher.querySelectorAll<HTMLButtonElement>('[data-theme-value]'));

		if (!toggle || !menu || !currentLabel || options.length === 0) return;

		const closeMenu = (restoreFocus = false) => {
			menu.hidden = true;
			toggle.setAttribute('aria-expanded', 'false');
			switcher.removeAttribute('data-open');
			if (restoreFocus) toggle.focus();
		};

		const openMenu = (focusOption = false) => {
			menu.hidden = false;
			toggle.setAttribute('aria-expanded', 'true');
			switcher.setAttribute('data-open', '');
			if (focusOption) {
				(options.find((option) => option.getAttribute('aria-pressed') === 'true') ?? options[0]).focus();
			}
		};

		const applyTheme = (value: string, persist = false) => {
			const selectedOption = options.find((option) => option.dataset.themeValue === value);
			if (!selectedOption) return;

			document.documentElement.dataset.theme = value;
			currentLabel.textContent = selectedOption.dataset.themeLabel ?? selectedOption.textContent ?? value;
			options.forEach((option) => {
				option.setAttribute('aria-pressed', String(option === selectedOption));
			});

			if (persist) {
				try {
					localStorage.setItem(themeStorageKey, value);
				} catch {
					// Le thème reste actif même si le stockage local est indisponible.
				}
			}
		};

		applyTheme(document.documentElement.dataset.theme ?? 'default');

		toggle.addEventListener('click', () => {
			if (menu.hidden) openMenu();
			else closeMenu();
		});

		toggle.addEventListener('keydown', (event) => {
			if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
			event.preventDefault();
			openMenu(true);
		});

		options.forEach((option) => {
			option.addEventListener('click', () => {
				applyTheme(option.dataset.themeValue ?? 'default', true);
				closeMenu(true);
			});
		});

		menu.addEventListener('keydown', (event) => {
			const currentIndex = options.indexOf(document.activeElement as HTMLButtonElement);
			if (event.key === 'Escape') {
				event.preventDefault();
				closeMenu(true);
				return;
			}

			let nextIndex: number | undefined;
			if (event.key === 'ArrowDown') nextIndex = (currentIndex + 1) % options.length;
			if (event.key === 'ArrowUp') nextIndex = (currentIndex - 1 + options.length) % options.length;
			if (event.key === 'Home') nextIndex = 0;
			if (event.key === 'End') nextIndex = options.length - 1;

			if (nextIndex !== undefined) {
				event.preventDefault();
				options[nextIndex].focus();
			}
		});

		document.addEventListener('click', (event) => {
			if (event.target instanceof Node && !switcher.contains(event.target)) closeMenu();
		});
	});
</script>
