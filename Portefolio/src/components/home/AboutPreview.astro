---
interface Props {
	eyebrow: string;
	title: string;
	paragraphs: readonly string[];
}

const { eyebrow, title, paragraphs } = Astro.props;
---

<section class="about-preview section">
	<div class="about-preview__grid container">
		<p class="eyebrow" data-reveal>{eyebrow}</p>
		<div class="about-preview__content flow">
			<h2 data-reveal style="--reveal-order: 1">{title}</h2>
			{paragraphs.map((paragraph, index) => (
				<p data-reveal style={`--reveal-order: ${index + 2}`}>{paragraph}</p>
			))}
		</div>
	</div>
</section>
